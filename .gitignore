# Task output directories. The worker anchors these on its working directory,
# so a worker started from a clone would otherwise stage real Boss task data.
.warp_temp/
.warp-demo/
.agentfm_temp/
.agentfm-demo/
agentfm_artifacts/
.playwright-cli/

# Build artifacts (generated locally, not committed)
warp-go/dist/
warp-go/warp
warp-go/relay

# Python bytecode
__pycache__/
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
.agents/*
